<reactiveUi:ReactiveUserControl x:TypeArguments="loadoutCard:ILoadoutCardViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveUi="http://reactiveui.net"
    xmlns:loadoutCard="clr-namespace:NexusMods.App.UI.Controls.LoadoutCard"
    xmlns:icons="clr-namespace:NexusMods.UI.Sdk.Icons;assembly=NexusMods.UI.Sdk"
    xmlns:loadoutBadge="clr-namespace:NexusMods.App.UI.Controls.LoadoutBadge"
    xmlns:spinner="clr-namespace:NexusMods.App.UI.Controls.Spinner"
    xmlns:controls="clr-namespace:NexusMods.App.UI.Controls"
    mc:Ignorable="d"
    x:Class="NexusMods.App.UI.Controls.LoadoutCard.LoadoutCardView">
    <Design.DataContext><loadoutCard:LoadoutCardDesignViewModel /></Design.DataContext>
    <Border x:Name="ContainerBorder">
        <Panel>
            <Grid x:Name="CardBody" RowDefinitions="*,Auto">
                <Button x:Name="CardOuterButton" Grid.Row="0" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Top" ToolTip.Tip="Open this profile">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="48,*">
                            <Border x:Name="ImageSectionBorder" VerticalAlignment="Top">
                                <Panel>
                                    <Image x:Name="GameImage" />
                                    <loadoutBadge:LoadoutBadge x:Name="LoadoutBadge" />
                                </Panel>
                            </Border>
                            <TextBlock x:Name="LoadoutNameTextBlock" Grid.Column="1" Margin="8,0,0,0"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Border x:Name="StatusBorder">
                            <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel x:Name="DetailsSectionStack" Spacing="3">
                            <TextBlock x:Name="NumberOfModsTextBlock" />
                            <TextBlock x:Name="LastAppliedTimeTextBlock" />
                            <TextBlock x:Name="CreatedTimeTextBlock" />
                        </StackPanel>
                        <TextBlock Text="Open profile →" Foreground="{StaticResource PrimaryModerateBrush}"
                                   Theme="{StaticResource BodySMSemiTheme}" />
                    </StackPanel>
                </Button>
                <Grid x:Name="ActionsDock" Grid.Row="1" ColumnDefinitions="*,*,Auto" Margin="12,0,12,12">
                    <controls:StandardButton x:Name="RenameButton" Grid.Column="0" Text="Rename" Size="Small"
                                             HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                    <controls:StandardButton x:Name="CreateCopyButton" Grid.Column="1" Text="Duplicate" Size="Small"
                                             HorizontalAlignment="Stretch" />
                    <controls:StandardButton x:Name="DeleteButton" Grid.Column="2" Margin="6,0,0,0"
                                             ShowLabel="False" ShowIcon="Left" Size="Small"
                                             LeftIcon="{x:Static icons:IconValues.DeleteForever}"
                                             ToolTip.Tip="Delete profile" />
                </Grid>
            </Grid>
            <StackPanel x:Name="OverlayStack" IsVisible="False" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                <spinner:Spinner Height="40" Width="40" />
                <TextBlock x:Name="OverlayTextBlock" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Panel>
    </Border>
</reactiveUi:ReactiveUserControl>
